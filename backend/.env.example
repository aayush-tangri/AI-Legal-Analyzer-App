# Copy this file to .env and fill in your key.

# REQUIRED: free Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: which Gemini model to use (default: gemini-flash-latest; falls back to others when busy)
# GEMINI_MODEL=gemini-flash-latest

# Optional: Pinecone knowledge base for grounded clause analysis
# PINECONE_API_KEY=

# Optional: Tavily web search for live loan-rate comparison
# TAVILY_API_KEY=
